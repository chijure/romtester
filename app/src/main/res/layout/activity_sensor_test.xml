<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sensor_label_accelerometer"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/text_accelerometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_reading_placeholder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sensor_label_gyroscope"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/text_gyroscope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_reading_placeholder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sensor_label_magnetic"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/text_magnetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_reading_placeholder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sensor_label_light"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/text_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_reading_placeholder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sensor_label_proximity"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/text_proximity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_reading_placeholder" />

    </LinearLayout>
</ScrollView>
