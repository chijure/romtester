<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_title" />

        <TextView
            android:id="@+id/text_wifi_status"
            style="@style/StatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wifi_status_ready" />

        <Button
            android:id="@+id/button_wifi_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/wifi_button_scan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/wifi_label_nearby"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_wifi_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_results_no_scan" />

    </LinearLayout>
</ScrollView>
